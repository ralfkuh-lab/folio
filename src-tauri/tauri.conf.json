{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.4.0",
  "identifier": "de.kulisoft.folio",
  "build": {
    "frontendDist": "dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown;text/x-markdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "recommends": ["python3-pil"],
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/folio.png": "icons/hicolor/16x16/apps/folio.png",
          "/usr/share/icons/hicolor/22x22/apps/folio.png": "icons/hicolor/22x22/apps/folio.png",
          "/usr/share/icons/hicolor/24x24/apps/folio.png": "icons/hicolor/24x24/apps/folio.png",
          "/usr/share/icons/hicolor/48x48/apps/folio.png": "icons/hicolor/48x48/apps/folio.png",
          "/usr/share/icons/hicolor/64x64/apps/folio.png": "icons/hicolor/64x64/apps/folio.png",
          "/usr/share/icons/hicolor/256x256/apps/folio.png": "icons/hicolor/256x256/apps/folio.png",
          "/usr/share/mime/packages/folio.xml": "linux/folio-mime.xml",
          "/usr/share/folio/install-folio-icons.sh": "../scripts/install-folio-icons.sh"
        }
      },
      "rpm": {
        "recommends": ["python3-pillow"],
        "files": {
          "/usr/share/icons/hicolor/16x16/apps/folio.png": "icons/hicolor/16x16/apps/folio.png",
          "/usr/share/icons/hicolor/22x22/apps/folio.png": "icons/hicolor/22x22/apps/folio.png",
          "/usr/share/icons/hicolor/24x24/apps/folio.png": "icons/hicolor/24x24/apps/folio.png",
          "/usr/share/icons/hicolor/48x48/apps/folio.png": "icons/hicolor/48x48/apps/folio.png",
          "/usr/share/icons/hicolor/64x64/apps/folio.png": "icons/hicolor/64x64/apps/folio.png",
          "/usr/share/icons/hicolor/256x256/apps/folio.png": "icons/hicolor/256x256/apps/folio.png",
          "/usr/share/mime/packages/folio.xml": "linux/folio-mime.xml",
          "/usr/share/folio/install-folio-icons.sh": "../scripts/install-folio-icons.sh"
        }
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Folio",
        "width": 1200,
        "height": 800,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  }
}
